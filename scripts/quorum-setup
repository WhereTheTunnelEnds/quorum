#!/usr/bin/env bash
# quorum-setup — one guided pass from nothing to a working Quorum install.
#
#   quorum-setup            # interactive: pick your providers, walk each one to green
#   quorum-setup --check    # non-interactive: report readiness and exit
#   quorum-setup --all      # interactive, but assume you want every provider offered
#
# Run this FIRST. It does, in order: prerequisites, PATH, provider selection, then for each
# provider install -> authenticate -> verify, and finishes by proving the whole thing works
# with a real call to each.
#
# It will never ask you for a key, a token, or an auth code. Installs and logins are printed
# for YOU to run — vendor installers execute remote code and logins bind your paid accounts,
# and anything pasted into an agent chat becomes transcript. See docs/safety-model.md.

set -uo pipefail

_src="$0"
while [ -L "$_src" ]; do
  _d=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_d/$_src" ;; esac
done
ROOT=$(cd -P "$(dirname "$_src")/.." && pwd)
# shellcheck source=/dev/null
. "$ROOT/scripts/quorum-lib.sh"

ENVFILE="$QUORUM_ENVFILE"
CHECK=0; ALL=0

for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    --all)   ALL=1 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "quorum-setup: unknown argument '$a'" >&2; exit 1 ;;
  esac
done

b()  { printf '\n\033[1m%s\033[0m\n' "$1"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
no() { printf '  \033[31m✗\033[0m %s\n' "$1"; }
hm() { printf '  \033[33m!\033[0m %s\n' "$1"; }
run() { printf '      \033[1m%s\033[0m\n' "$1"; }

interactive() { [ "$CHECK" -eq 0 ] && [ -t 0 ]; }

# Read from STDIN, not /dev/tty. `interactive` tests stdin (`-t 0`), so reading from a
# different descriptor can block on a terminal nobody is typing at — a detached pty, a
# harness, `< /dev/null`. Measured: that combination hung forever with no output at all.
#
# Every read is bounded. A setup script must never be able to hang indefinitely: it is the
# first thing a new user runs, and a silent hang is indistinguishable from a broken install.
ASK_TIMEOUT="${QUORUM_ASK_TIMEOUT:-120}"
ask() {  # ask <prompt> ; yes = 0
  interactive || return 1
  printf '  %s [y/N] ' "$1"
  if read -r -t "$ASK_TIMEOUT" a; then
    case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
  else
    printf '\n  (no answer in %ss — assuming no)\n' "$ASK_TIMEOUT"; return 1
  fi
}
pause() {
  interactive || return 0
  printf '  press return when done (or ctrl-c to stop) '
  read -r -t "$ASK_TIMEOUT" _ || printf '\n  (continuing)\n'
  return 0
}

missing=0
# Counts things that make Quorum NOT READY, which is narrower than "not perfect": a provider
# you do not use is a normal state and must never fail the check. Only infrastructure counts.
notready=0

# ── 1. prerequisites ────────────────────────────────────────────────────────────
b "1. Prerequisites"
for c in git curl jq; do
  command -v "$c" >/dev/null 2>&1 && ok "$c" || { no "$c missing"; missing=$((missing+1)); }
done
command -v node >/dev/null 2>&1 && ok "node $(node --version 2>/dev/null)" \
  || hm "node missing — needed only for the Codex and Copilot CLIs"
# quorum-sanitize is what keeps provider output from forging a status line, and it needs
# perl. This is a hard requirement, not a nicety: without it every adapter refuses to run.
# It is checked FUNCTIONALLY rather than with `command -v`, because the failure that matters
# is "the file exists but does not run" -- measured, that yields an empty answer that the
# classification tables read as `empty`.
if printf . | quorum-sanitize >/dev/null 2>&1; then
  ok "quorum-sanitize works (provider output can be sanitised)"
elif command -v quorum-sanitize >/dev/null 2>&1; then
  no "quorum-sanitize is installed but does not run — is perl present?"
  run "$QUORUM_PKG_INSTALL perl"
  notready=$((notready+1))
else
  no "quorum-sanitize not on PATH — adapters will refuse to run"
  run "$ROOT/scripts/install.sh"
  notready=$((notready+1))
fi

if command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1; then
  ok "timeout"
else
  hm "timeout(1) missing — hang detection disabled"
  run "$QUORUM_PKG_TIMEOUT"
fi
[ "$missing" -gt 0 ] && { echo; no "install the missing prerequisites first"; run "$QUORUM_PKG_INSTALL git curl jq"; exit 1; }

# ── 2. PATH ─────────────────────────────────────────────────────────────────────
b "2. Helper scripts on PATH"
if command -v quorum-verify >/dev/null 2>&1; then
  ok "quorum-* commands resolve"
elif [ -x "$HOME/.local/bin/quorum-verify" ]; then
  # `command -v` asks THIS shell, and install.sh cannot change the PATH of the shell that
  # invoked it -- so a correctly installed machine showed a red X, was told to re-run the
  # installer, and showed the same X again. Measured: two consecutive --check runs both
  # exit 1 while a fresh login shell exits 0, with two contradictory status lines in one
  # screen of output. Whether a NEW shell can find it is the visibility probe's job below.
  ok "quorum-* installed in ~/.local/bin (not on THIS shell's PATH — open a new terminal)"
else
  no "quorum-* not on PATH"
  notready=$((notready+1))
  if ask "run the installer now (symlinks into ~/.local/bin)?"; then
    "$ROOT/scripts/install.sh" || true
  else
    run "$ROOT/scripts/install.sh"
  fi
fi
# Agents get a NON-interactive shell. A PATH that only your interactive shell knows about
# works for you and fails for every subagent.
#
# How you TEST that differs by shell, and the old code tested only one way: it ran
# `env -i zsh -c ...` unconditionally. On a machine without zsh that can only fail, so it
# told every Linux user "NOT visible to non-interactive shells" and then offered a fix that
# also did nothing. A check that can only fail is as useless as one that can only pass.
#
# zsh genuinely reads ~/.zshenv on every invocation, so `env -i` is a faithful test there.
# bash reads NOTHING per-invocation when non-interactive — its mechanism is inheritance from
# ~/.profile at login — and `env -i` deliberately destroys the inherited environment, so the
# same test would report failure on a correctly configured machine. For bash, check the env
# file for the PATH line, which is what actually governs it.
# Ask the shell, in the mode that actually governs it. Both branches below run the user's
# real shell with a CLEARED environment, so the answer can only come from a file that shell
# reads — which is the whole question.
#
# The first version of this check ran `env -i zsh -c` for everyone, which on a machine
# without zsh could only FAIL. Its replacement, for non-zsh, consulted `$PATH` of the
# invoking shell — which could only PASS, since that PATH is inherited from the very
# terminal running the check and says nothing about what a subagent will see. Two useless
# checks in opposite directions, both of them contradicting the comment directly above.
#
# zsh: `-c` is enough, because zsh reads ~/.zshenv on every invocation.
# bash: `-lc` is required, because bash's mechanism is a LOGIN file, and a non-login
#       non-interactive bash reads nothing at all.
_visible=1
_shname=$(basename "${SHELL:-sh}")
case "$_shname" in
  # ZDOTDIR must be carried through. quorum-lib.sh writes to ${ZDOTDIR:-$HOME}/.zshenv, but
  # `env -i HOME=...` dropped ZDOTDIR, so the probe read a DIFFERENT file than the one
  # written. Measured on a ZDOTDIR user: a genuinely working machine reported "NOT visible"
  # on every run, and since the append is offered each time, the export line accumulated
  # without bound -- 1, 2, then 3 copies over three runs.
  zsh)  env -i HOME="$HOME" ${ZDOTDIR:+ZDOTDIR="$ZDOTDIR"} zsh -c 'command -v quorum-verify' >/dev/null 2>&1 || _visible=0 ;;
  bash) env -i HOME="$HOME" bash -lc 'command -v quorum-verify' >/dev/null 2>&1 || _visible=0 ;;
  *)
    # Unknown shell: try a login shell, and fall back to inspecting the env file rather
    # than asserting either way. Never fall back to $PATH — that is the can-only-pass trap.
    if command -v "$_shname" >/dev/null 2>&1; then
      env -i HOME="$HOME" "$_shname" -lc 'command -v quorum-verify' >/dev/null 2>&1 || _visible=0
    else
      { [ -r "$ENVFILE" ] && grep -q '\.local/bin' "$ENVFILE"; } || _visible=0
    fi ;;
esac
if [ "$_visible" = 1 ]; then
  ok "visible to non-interactive shells (agents will find it)"
else
  hm "NOT visible to non-interactive shells — agents will report it missing"
  notready=$((notready+1))
  run "echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> $ENVFILE"
  if ask "append that line to $ENVFILE now?"; then
    # Check the write. Measured on a read-only ~/.bash_profile: the redirect printed
    # "Permission denied", `ok` ran anyway, the file was still 0 bytes, and the tool
    # reported "appended". A read-only login file is not exotic -- root-owned, immutable,
    # full disk, or a parent directory that does not exist all land here.
    #
    # mkdir -p first: on fish the target is ~/.config/fish/conf.d/quorum.fish, and that
    # directory does not exist on a machine where fish has never written a config.
    # quorum-auth already did this; quorum-setup did not.
    # Braces around the redirect: `printf ... >> f 2>/dev/null` silences printf, but the
    # shell reports a FAILED REDIRECTION itself, before printf ever runs. Grouping puts the
    # redirect inside the silenced region, so the only message is the honest one below.
    if mkdir -p "$(dirname "$ENVFILE")" 2>/dev/null &&
       { printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$ENVFILE"; } 2>/dev/null; then
      ok "appended — open a new terminal for it to take effect"
    else
      no "could not write to $ENVFILE"
      note "add the line above by hand, or fix the permissions and re-run"
    fi
  fi
fi

# ── 3. providers ────────────────────────────────────────────────────────────────
# name^binary^install^note
# Delimiter is ^ and not | on purpose: install commands contain pipes.
PROVIDERS='codex^codex^npm install -g @openai/codex^ChatGPT subscription
copilot^copilot^npm install -g @github/copilot^GitHub Copilot subscription
glm^-^get an API key from https://z.ai, then: quorum-auth glm --set-key^Z.AI Coding Plan, 1M context
ollama^-^see https://ollama.com/download, then: ollama pull llama3.2:3b^local, free, private, no account
openrouter^-^get a key from https://openrouter.ai/settings/keys, then export OPENROUTER_API_KEY^metered per token, many vendors behind one key
antigravity^agy^curl -fsSL https://antigravity.google/cli/install.sh | bash^Google; replaces the retired Gemini CLI'

present() {  # present <name> <binary>
  case "$1" in
    glm)    [ -n "${Z_AI_API_KEY:-}" ] ;;
    ollama) curl -s -m 3 "${OLLAMA_BASE:-http://localhost:11434}/api/tags" >/dev/null 2>&1 ;;
    openrouter) [ -n "${OPENROUTER_API_KEY:-}" ] ;;
    *)      command -v "$2" >/dev/null 2>&1 ;;
  esac
}

b "3. Providers"
echo "  Every provider is optional. Quorum works with one; it gets more useful with three."
echo

while IFS='^' read -r name bin inst note; do
  [ -z "$name" ] && continue
  if present "$name" "$bin"; then
    ok "$(printf '%-12s' "$name") already present — $note"
  else
    no "$(printf '%-12s' "$name") not present — $note"
    # Always print the install command, including in --check mode: it is the actionable
    # part, and a readiness report that withholds the fix is only half a report.
    run "$inst"
    if [ "$CHECK" -eq 0 ]; then
      if [ "$ALL" -eq 1 ] || ask "    set $name up now? (run the line above, then return here)"; then
        pause
      fi
    fi
  fi
done <<EOF
$PROVIDERS
EOF

# ── 4. authenticate ─────────────────────────────────────────────────────────────
b "4. Authentication"
if command -v quorum-auth >/dev/null 2>&1; then AUTH=quorum-auth; else AUTH="$ROOT/scripts/quorum-auth"; fi
# `|| true` is a DECISION, not an oversight, and `notready` is deliberately not touched
# here. Every provider is optional, so an unauthenticated one -- or an exhausted monthly
# quota -- does not make the INSTALL unready. quorum-auth prints its own "N item(s) need
# attention" for the provider; this step's verdict is about whether Quorum itself is set up.
# Without this note the next person reads a bare `|| true` as swallowed error handling and
# "fixes" it into a check that fails on any provider the user does not own.
"$AUTH" || true
echo
echo "  Anything marked above needs YOU to run its fix: logins open a browser and bind your"
echo "  account, and an agent shell has no terminal to complete one in."
echo "  Never paste a key, token, or auth code into a chat — nothing here needs it."
if ask "run the interactive logins now ($AUTH --fix)?"; then "$AUTH" --fix || true; fi

# ── 5. prove it ─────────────────────────────────────────────────────────────────
b "5. Does it actually work?"
echo "  Authentication is not the same as working — only a real call proves that."
# --check is a READINESS REPORT and must stay cheap: it previously ran the full verify
# suite, so the flag that sounds passive was the expensive one, and /quorum:setup fired
# five billable provider calls every time. Never print the header as though the proof ran.
if [ "$CHECK" -eq 1 ]; then
  echo "  Skipped: --check is a readiness report and does not spend provider quota."
  echo "  To actually prove it:  quorum-verify --all"
elif ask "run quorum-verify --all now? (makes a real call to each provider)"; then
  if command -v quorum-verify >/dev/null 2>&1; then quorum-verify --all || true
  else "$ROOT/scripts/quorum-verify" --all || true; fi
else
  echo "  Skipped — nothing has been proven to work yet."
  echo "  Run when ready:  quorum-verify --all"
fi

b "Next"
echo "  /plugin marketplace add WhereTheTunnelEnds/quorum   install the Claude Code half"
echo "  /quorum:panel <a hard question>                      fan it out to every provider"
echo "  /quorum:add-provider <name>                          adapt a provider we don't cover"
echo "  quorum-flags                                         after any provider CLI update"
echo
echo "  Guide: docs/getting-started.md   Problems: docs/troubleshooting.md"

# Exit status, because this script previously ended on an `echo` and so returned 0 no matter
# what it had just reported. `quorum-setup --check && echo ready` printed "ready" while the
# report above it said "quorum-* not on PATH". Third time this exact shape has been found
# here: quorum-verify once exited 0 having verified nothing, and quorum-status once exited 1
# while reporting everything fine.
#
# Semantics: --check exits 1 when Quorum is NOT READY, 0 when it is. A provider you do not
# use is a normal state and does not count — only the infrastructure does, meaning PATH and
# whether agents can actually see it. Interactive mode always exits 0: it is a guided
# walkthrough, and a user declining an optional step is not a failure.
if [ "$CHECK" -eq 1 ] && [ "$notready" -gt 0 ]; then
  echo
  echo "  NOT READY: $notready item(s) above need attention." >&2
  exit 1
fi
exit 0
