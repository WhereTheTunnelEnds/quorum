#!/usr/bin/env bash
# quorum-auth — diagnose and fix provider authentication.
#
#   quorum-auth                 # what needs auth, and the exact command that fixes each
#   quorum-auth --fix           # run the interactive login flows for anything unauthenticated
#   quorum-auth <provider>...   # only these
#   quorum-auth glm --set-key   # read a key from a silent prompt and store it in ~/.zshenv
#   quorum-auth glm --init-endpoint  # write the quorum-claude-on preset (no key in it)
#
# quorum-status tells you what is broken. This tells you what to do about it.
#
# Never prints, echoes, or logs key material. `--set-key` reads with `read -s`, so the key
# does not reach your shell history, your terminal, or this script's output.
#
# Run the interactive logins YOURSELF, in your own terminal. Never paste an auth code, a
# device code, or a key into a chat with an agent — that puts it in a transcript, which is
# stored and may be summarised or logged. Nothing here needs it: this script confirms auth
# by making a real call, which is better evidence than a pasted code anyway.

set -uo pipefail

FIX=0; SET_KEY=0; INIT_EP=0; WANT=""
for a in "$@"; do
  case "$a" in
    --fix)      FIX=1 ;;
    --set-key)  SET_KEY=1 ;;
    --init-endpoint) INIT_EP=1 ;;
    -h|--help)  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)         echo "quorum-auth: unknown flag $a" >&2; exit 1 ;;
    *)          WANT="$WANT $a" ;;
  esac
done
wants() { [ -z "$WANT" ] && return 0; case " $WANT " in *" $1 "*) return 0;; *) return 1;; esac; }

# Resolve through symlinks so the shared lib is findable when installed the documented
# way: install.sh links this onto PATH, and `dirname "$0"` would give ~/.local/bin, not the
# repo. macOS has no `readlink -f`.
_qsrc="$0"
while [ -L "$_qsrc" ]; do
  _qdir=$(cd -P "$(dirname "$_qsrc")" && pwd)
  _qsrc=$(readlink "$_qsrc")
  case "$_qsrc" in /*) ;; *) _qsrc="$_qdir/$_qsrc" ;; esac
done
# shellcheck source=/dev/null
. "$(cd -P "$(dirname "$_qsrc")" && pwd)/quorum-lib.sh"

ENVFILE="$QUORUM_ENVFILE"
need=0

# macOS ships no timeout(1). Degrade instead of emitting `timeout: command not found`,
# which surfaces as a bare rc=127 and reads like a provider fault rather than a missing
# local tool. Same class of leak the field notes warn about.
_TO=$(command -v timeout || command -v gtimeout || true)
qt() { if [ -n "$_TO" ]; then "$_TO" "$@"; else shift; "$@"; fi; }

ok()   { printf '  \033[32m%s\033[0m  %s\n' "OK" "$1"; }
bad()  { printf '  \033[31m%s\033[0m  %s\n' "--" "$1"; need=$((need+1)); }
todo() { printf '        \033[1mfix:\033[0m %s\n' "$1"; }
note() { printf '        %s\n' "$1"; }

echo "quorum auth"
echo

# --fix launches INTERACTIVE login flows: `codex login` opens a browser and waits for the
# callback, `agy` does the same. With no terminal there is nobody to complete them, so the
# command blocks until something kills it — and a real login's device code is printed into
# whatever is capturing stdout on the way.
#
# `--set-key` has been TTY-gated since it was written; `--fix` was not, while commands/auth.md
# advertises it and grants Bash(quorum-auth:*), so an agent could invoke exactly this path.
# The hang is the failure quorum-setup argues must be impossible, so refuse it here too.
if [ "$FIX" = 1 ] && [ ! -t 0 ]; then
  echo "  --fix needs a terminal: it starts interactive browser logins that nobody can" >&2
  echo "  complete without one. Run it yourself in your own terminal:" >&2
  echo >&2
  echo "      quorum-auth --fix" >&2
  echo >&2
  echo "  Running without --fix is safe here and will print the exact fix for each provider." >&2
  exit 2
fi

# --- Claude Code ---------------------------------------------------------------
if wants claude; then
  if [ -f "$HOME/.claude.json" ] && command -v jq >/dev/null 2>&1 \
     && jq -e 'has("oauthAccount")' "$HOME/.claude.json" >/dev/null 2>&1; then
    ok "claude    logged in"
  else
    bad "claude    not logged in"
    todo "claude    (then /login inside the session)"
  fi
fi

# --- Codex ---------------------------------------------------------------------
if wants codex; then
  if ! command -v codex >/dev/null 2>&1; then
    bad "codex     not installed"
    todo "npm install -g @openai/codex"
  elif codex login status >/dev/null 2>&1; then
    ok "codex     logged in"
  else
    bad "codex     not logged in"
    todo "codex login          # browser OAuth, spends your ChatGPT subscription"
    note "do NOT use an API key here — that bills per token instead"
    [ "$FIX" = 1 ] && { echo; codex login; echo; }
  fi
fi

# --- Copilot -------------------------------------------------------------------
if wants copilot; then
  if ! command -v copilot >/dev/null 2>&1; then
    bad "copilot   not installed"
    todo "npm install -g @github/copilot"
  else
    # `command -v` + --version only proves the BINARY is present. Copilot stores its token
    # in the system credential store, so there is no readable file to inspect — the only
    # reliable check is a real call. Reporting "installed" as if it were "logged in" is how
    # an all-green auth report hides a provider that will fail on first use.
    _cp_out=$(mktemp); _cp_err=$(mktemp)
    qt 90 copilot -p "hi" -s --no-ask-user --allow-tool "read" >"$_cp_out" 2>"$_cp_err"
    _cp_rc=$?
    if [ "$_cp_rc" = 0 ] && [ -s "$_cp_out" ]; then
      ok "copilot   logged in ($(copilot --version 2>&1 | head -1))"
    elif grep -qiE 'auth|login|sign in|credential|token' "$_cp_err" "$_cp_out" 2>/dev/null; then
      bad "copilot   not logged in"
      todo "copilot login        # browser OAuth, or --device-code on a headless box"
    elif [ "$_cp_rc" = 124 ]; then
      bad "copilot   timed out (90s) with no auth error"
      todo "copilot              # run interactively and see what it asks for"
    else
      bad "copilot   rc=$_cp_rc: $(head -c 100 "$_cp_err" | tr '\n' ' ')"
    fi
    rm -f "$_cp_out" "$_cp_err"
  fi
fi

# --- Antigravity ---------------------------------------------------------------
if wants antigravity || wants agy; then
  # The binary is `agy`, NOT `antigravity`. See docs/field-notes.md.
  if ! command -v agy >/dev/null 2>&1; then
    if [ -x "$HOME/.local/bin/agy" ]; then
      bad "agy       installed but not on PATH for non-interactive shells"
      todo "echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> $ENVFILE"
      note "its installer writes PATH to ~/.zshrc, which agents never read"
    else
      bad "agy       not installed"
      todo "curl -fsSL https://antigravity.google/cli/install.sh | bash"
    fi
  elif [ -n "${GEMINI_API_KEY:-}" ]; then
    # Scripted path: no browser, works in CI. The binary references GEMINI_API_KEY, and the
    # vendor documents key auth for headless runs — but this has NOT been verified here (no
    # key available), so report it as configured rather than as working.
    ok "agy       GEMINI_API_KEY set — headless auth path (unverified here)"
    note "confirm with a real call: agy --print 'hi'"
  else
    # No cheap offline credential check exists: `agy models` and `agy agents` HANG when
    # unauthenticated rather than failing, so they cannot be used as a probe. A short
    # --print does fail fast, and costs one trivial call when already logged in.
    _ag_err=$(mktemp)
    qt 60 agy --print "hi" >/dev/null 2>"$_ag_err"; _ag_rc=$?
    if [ "$_ag_rc" = 0 ]; then
      ok "agy       logged in ($(agy --version 2>/dev/null | head -1))"
    elif grep -qi 'authentication' "$_ag_err" 2>/dev/null; then
      bad "agy       not logged in"
      todo "agy                  # opens the interactive login (browser), ONE TIME"
      note "credentials persist in ~/.gemini/antigravity-cli/ — not a per-session step"
      note "fully scripted alternative: export GEMINI_API_KEY in ~/.zshenv (no browser)"
      if [ "$FIX" = 1 ]; then
        echo; echo "  launching 'agy' — complete the login, then quit the TUI to return here"; echo
        agy || true
        echo
      fi
    elif [ "$_ag_rc" = 124 ]; then
      bad "agy       timed out (60s) with no auth error — is a login half-finished?"
      todo "agy                  # run it interactively and see what it asks for"
    else
      bad "agy       rc=$_ag_rc: $(head -c 120 "$_ag_err" | tr '\n' ' ')"
    fi
    rm -f "$_ag_err"
  fi
fi

# --- Ollama ----------------------------------------------------------------------
if wants ollama; then
  _ol_base="${OLLAMA_BASE:-http://localhost:11434}"
  _ol_tags=$(curl -s -m 5 "$_ol_base/api/tags" 2>/dev/null)
  if [ -z "$_ol_tags" ]; then
    bad "ollama    no server at $_ol_base"
    todo "ollama serve         # not installed? https://ollama.com/download"
  else
    _ol_n=$(printf '%s' "$_ol_tags" | jq -r '.models | length' 2>/dev/null || echo 0)
    case "$_ol_n" in ''|*[!0-9]*) _ol_n=0 ;; esac
    if [ "$_ol_n" -eq 0 ]; then
      bad "ollama    server up, no model pulled"
      todo "ollama pull llama3.2:3b"
    else
      ok "ollama    $_ol_n model(s) — no auth required"
    fi
  fi
fi

# --- GLM / Z.AI ----------------------------------------------------------------
if wants glm; then
  if [ "$SET_KEY" = 1 ]; then
    if [ ! -t 0 ]; then
      echo "  --set-key needs a terminal (it reads the key from a hidden prompt)" >&2
      echo "  run it yourself: quorum-auth glm --set-key" >&2
      exit 1
    fi
    printf '  paste your Z.AI key (input hidden, not echoed, %ss): ' "${QUORUM_ASK_TIMEOUT:-120}"
    # Bounded, like every read in quorum-setup. A prompt that can block forever is the same
    # hang class, and this one is worse: it is silent because the input is hidden.
    if ! read -rs -t "${QUORUM_ASK_TIMEOUT:-120}" KEY; then
      echo; echo "  timed out; no change made" >&2; KEY=""
    fi
    echo
    if [ -z "$KEY" ]; then
      echo "  nothing entered; no change made" >&2
    else
      # $ENVFILE is resolved by quorum-lib.sh against the user's actual shell — for bash it
      # is whichever of .bash_profile / .bash_login / .profile that shell really reads.
      if grep -qE '^(export Z_AI_API_KEY=|set -gx Z_AI_API_KEY )' "$ENVFILE" 2>/dev/null; then
        echo "  $ENVFILE already exports Z_AI_API_KEY; leaving it alone." >&2
        echo "  Edit it by hand if you need to replace the key." >&2
      else
        umask 077
        if [ "$QUORUM_ENVFILE_SYNTAX" = fish ]; then
          # fish cannot parse `export X=y`. Writing it produces a file fish reads and then
          # errors on, which is worse than not writing at all.
          mkdir -p "$(dirname "$ENVFILE")"
          printf 'set -gx Z_AI_API_KEY %s\n' "$KEY" >> "$ENVFILE"
        else
          printf '\nexport Z_AI_API_KEY=%q\n' "$KEY" >> "$ENVFILE"
        fi
        # umask only governs file CREATION. Appending to an existing file leaves its mode
        # untouched — measured: -rw-r--r-- with a live key in it. Set it explicitly. This
        # can tighten a login file shared with other tools, which is the correct trade once
        # a secret is in it — but report it rather than doing it silently.
        _oldmode=$(ls -l "$ENVFILE" 2>/dev/null | cut -c1-10)
        chmod 600 "$ENVFILE" 2>/dev/null || true
        echo "  wrote an export to $ENVFILE (now mode 600, was ${_oldmode:-new file})"
        echo "  open a new terminal for it to take effect"
        # THE KEY MUST BECOME VISIBLE TO THIS PROCESS TOO. Without this, the checks below
        # re-read $Z_AI_API_KEY from the current environment — which the write never touched
        # — so the SUCCESS path printed a red "Z_AI_API_KEY not set", named itself as its
        # own unrun fix, and exited 1. Measured under a pty: the file held the key while the
        # command reported failure. Verbatim the bug already fixed once for
        # --init-endpoint; this sibling path was missed.
        export Z_AI_API_KEY="$KEY"
      fi
      unset KEY
    fi
    echo
  fi

  if [ -z "${Z_AI_API_KEY:-}" ]; then
    bad "glm       Z_AI_API_KEY not set"
    todo "quorum-auth glm --set-key        # silent prompt, stores in $QUORUM_ENVFILE_SHORT"
    note "or by hand, and do BOTH parts:"
    note "  echo 'export Z_AI_API_KEY=\"...\"' >> $QUORUM_ENVFILE_SHORT && chmod 600 $QUORUM_ENVFILE_SHORT"
    note "$QUORUM_ENVFILE_WHY"
  else
    # The key goes in a HEADER FILE, never on the command line. Measured: with
# `-H "Authorization: Bearer $KEY"`, `ps auxww` shows the key to any process running as
# you. curl reads @file and it never reaches argv.
    _hdr=$(mktemp); chmod 600 "$_hdr"
    printf 'Authorization: Bearer %s\n' "$Z_AI_API_KEY" > "$_hdr"
    body=$(curl -s -m 20 https://api.z.ai/api/anthropic/v1/messages \
      -H @"$_hdr" \
      -H "anthropic-version: 2023-06-01" -H "content-type: application/json" \
      -d '{"model":"glm-5.3","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}' 2>/dev/null)
    # z.ai returns failures inside HTTP 200 — classify on the body, never the exit code.
    if printf '%s' "$body" | grep -q '"content"'; then
      ok "glm       key accepted"
      # A valid key covers the CONSULT tier only. Verify and delegate run Claude Code
      # against the GLM endpoint via quorum-claude-on, which needs a preset. Without it
      # those tiers fail at use time, long after auth "passed" — so check it here.
      _ep="${QUORUM_ENDPOINT_DIR:-$HOME/.config/quorum/endpoints}/zai.env"
      if [ -f "$_ep" ]; then
        ok "glm       endpoint preset present (verify + delegate tiers usable)"
      else
        bad "glm       no endpoint preset — verify and delegate tiers will fail"
        todo "quorum-auth glm --init-endpoint"
        note "consult works without it; only the tiers that run Claude Code need it"
        if [ "$FIX" = 1 ] || [ "$INIT_EP" = 1 ]; then
          mkdir -p "$(dirname "$_ep")"
          cat > "$_ep" <<'PRESET'
# Z.AI endpoint for quorum-claude-on. Contains NO key material: the token is read from the
# environment at run time, so this file is safe to keep and safe to back up.
ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
ANTHROPIC_AUTH_TOKEN="${Z_AI_API_KEY:?set Z_AI_API_KEY in ~/.zshenv}"
ANTHROPIC_DEFAULT_OPUS_MODEL="glm-5.3"
ANTHROPIC_DEFAULT_SONNET_MODEL="glm-5.3"
ANTHROPIC_DEFAULT_HAIKU_MODEL="glm-5-turbo"
# Pinned so a parent session's [1m] context-variant suffix cannot leak into the model id.
ANTHROPIC_MODEL="glm-5.3"
CLAUDE_CODE_AUTO_COMPACT_WINDOW="1048576"
PRESET
          chmod 600 "$_ep"
          printf '        \033[32mcreated\033[0m %s\n' "$_ep"
          # The gap is closed now. Without this the status was computed before the write
          # and never revisited, so the documented success path rendered in red, named
          # itself as its own unrun "fix", and exited 1.
          need=$((need-1))
          ok "glm       endpoint preset created (verify + delegate tiers usable)"
        fi
      fi
    else
      msg=$(printf '%s' "$body" | jq -r '.error.message // "no response"' 2>/dev/null || echo "no response")
      bad "glm       $msg"
      todo "get a fresh key from https://z.ai then: quorum-auth glm --set-key"
    fi
  fi
fi

echo
if [ "$need" -eq 0 ]; then
  echo "Everything requested is authenticated."
  echo "Confirm it actually works:  quorum-verify --all"
else
  echo "$need item(s) need attention. Re-run with --fix to start the interactive logins."
  echo "Providers are independent — Quorum works fine with only some of them."
fi
[ "$need" -eq 0 ]
