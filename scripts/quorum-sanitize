#!/usr/bin/env bash
# quorum-sanitize — make provider output safe to place inside the untrusted-output fence.
#
#   TEXT=$(... provider call ... | quorum-sanitize)
#
# Reads stdin, writes stdin-made-safe to stdout. Never fails on content; the only non-zero
# exit is a missing perl.
#
# WHY THIS IS A COMMAND AND NOT A PARAGRAPH
#
# The rule used to live as prose in all five adapters plus a `tr` fragment quoted with no
# input, no output and no assignment — sitting 95 to 313 lines below the line that actually
# captured the provider's text. An audit measured the result: `grep -c 'sed -e' agents/*.md`
# returned 0 for every adapter. The substitution half of a rule the contract marks MUST was
# in no runnable path anywhere in the repo, and adapters are explicitly meant to run on
# haiku-class models — the ones least able to reconstruct a correct sed from a sentence.
#
# A rule that is not in the pipeline is not a rule. One command, on PATH, in the pipe.
#
# WHAT IT DOES, AND WHY EACH STEP EXISTS
#
# 1. Removes invisible formatting characters (zero-width space/joiner, BOM, word-joiner).
#    A zero-width space inside the closing marker defeated the old substitution while
#    rendering identically to a human and to a model.
#
# 2. Neutralises the fence markers tolerantly: any dash count, any case, any run of
#    whitespace between words, split across lines, and with Cyrillic or fullwidth
#    homoglyphs folded to ASCII first. The old sed matched one exact byte sequence, so
#    "--- ЕND UNTRUSTED PROVIDER OUTPUT ---" (Cyrillic E) passed through and closed
#    the fence early, after which attacker text read as adapter-authored.
#
#    The replacement is deliberately NON-EMPTY. With an empty replacement, text either
#    side could join to form a NEW marker after substitution.
#
# 3. Strips C0 controls, keeping tab and newline. `\033[A` moves the cursor up and
#    overwrites the line above — which is the adapter's own `status:` line.
#
# 4. Strips C1 controls (U+0080-U+009F), which the old `tr` did not, in either encoding.
#    This is the finding that made this script necessary. U+009B is a single-character CSI:
#    every byte after it is printable ASCII, so the whole ANSI repertoire is reachable
#    without using one byte the old filter removed. Measured: a payload emitting
#    `status: error` rendered as `status: ok` in GNU screen 4.00.03, the build macOS ships.
#    tmux 3.6a treats it as inert; one honouring emulator is enough.
#
#    It must be UTF-8-aware. Extending the old byte-range `tr` to \200-\237 corrupts
#    legitimate text: measured, it turns the Japanese for "Japan" (e6 97 a5 e6 9c ac) into
#    mojibake. Perl decodes first, so multi-byte characters survive intact.
#
# WHAT IT IS NOT
#
# Not a parser boundary, and not a security boundary. It reduces a forged fence from
# invisible to visible. The caller must still treat everything inside the fence as data —
# see docs/adapter-contract.md. A model that decides to obey instructions it read inside
# the fence is not something a filter can prevent.

set -uo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
quorum-sanitize — make provider output safe to place inside the untrusted-output fence.

  provider-call | quorum-sanitize

Neutralises the BEGIN/END fence markers (tolerant of case, spacing, dash count, homoglyphs,
zero-width characters and line splits), then strips C0 and C1 control characters while
keeping tab, newline and all legitimate non-ASCII text.

Reads stdin, writes stdout. Not a security boundary — treat fenced text as data regardless.
USAGE
    exit 0 ;;
esac

if ! command -v perl >/dev/null 2>&1; then
  echo "quorum-sanitize: needs perl (ships with macOS and every mainstream Linux)" >&2
  exit 127
fi

# -CSD: decode stdin and encode stdout as UTF-8, so character classes mean characters.
# Invalid UTF-8 is replaced rather than fatal — provider output is untrusted by definition
# and must not be able to kill the filter. That is why this is not `use strict; die`.
exec perl -CSD -Mutf8 -e '
  binmode(STDIN,  ":encoding(UTF-8)");
  binmode(STDOUT, ":encoding(UTF-8)");
  local $/;                      # slurp: a marker may be split across lines
  my $t = <STDIN>;
  exit 0 unless defined $t;

  # 1. invisible formatting characters, removed outright
  $t =~ s/[\x{200B}-\x{200F}\x{2060}-\x{2064}\x{FEFF}]//g;

  # 2. fold confusables to ASCII in a COPY of equal length, match there, splice the original
  # Only the letters that appear in the marker, and only where a Cyrillic or Greek
  # character is visually identical to the Latin one. A blanket transliteration would be
  # both wrong and unnecessary -- this copy exists solely to locate the marker.
  my $f = $t;
  $f =~ s/([\x{FF21}-\x{FF3A}])/chr(ord($1) - 0xFF21 + ord("A"))/ge;   # fullwidth A-Z
  $f =~ s/([\x{FF41}-\x{FF5A}])/chr(ord($1) - 0xFF41 + ord("a"))/ge;   # fullwidth a-z
  $f =~ tr/\x{0410}\x{0412}\x{0415}\x{041A}\x{041C}\x{041D}\x{041E}\x{0420}\x{0421}\x{0422}\x{0423}\x{0425}/AVEKMHOPCTYX/;  # Cyrillic caps
  $f =~ tr/\x{0430}\x{0435}\x{043E}\x{0440}\x{0441}\x{0443}\x{0445}/aeopcyx/;                    # Cyrillic lower
  $f =~ tr/\x{0391}\x{0392}\x{0395}\x{0396}\x{0397}\x{0399}\x{039A}\x{039C}\x{039D}\x{039F}\x{03A1}\x{03A4}\x{03A5}\x{03A7}/ABEZHIKMNOPTYX/;  # Greek caps
  $f =~ s/\x{2010}|\x{2011}|\x{2012}|\x{2013}|\x{2014}|\x{2015}|\x{2212}/-/g;                    # dash lookalikes

  my $re = qr/-{2,}\s*(?:BEGIN|END)\s+UNTRUSTED\s+PROVIDER\s+OUTPUT(?:\s*-{2,})?/i;
  my @spans;
  while ($f =~ /$re/g) { push @spans, [ $-[0], $+[0] ] }
  for my $s (reverse @spans) {
    substr($t, $s->[0], $s->[1] - $s->[0]) = "[marker neutralised]";
  }

  # 3. C0 controls except tab and newline, plus DEL
  $t =~ s/[\x{0000}-\x{0008}\x{000B}-\x{001F}\x{007F}]//g;

  # 4. C1 controls, in whatever encoding they arrived as
  $t =~ s/[\x{0080}-\x{009F}]//g;

  print $t;
'
