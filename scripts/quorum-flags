#!/usr/bin/env bash
# quorum-flags — keep adapters honest about the CLI surface they depend on.
#
#   quorum-flags                 # CHECK: every flag our adapters use still exists
#   quorum-flags --capture       # snapshot each provider's --help into reference/flags/
#   quorum-flags --diff          # what changed in the surface since the snapshot
#   quorum-flags --list <prov>   # the provider's full flag surface, as it is today
#
# Why this exists: an adapter is a set of assumptions about someone else's CLI. Vendors
# rename flags. When `--no-ask-user` becomes `--non-interactive`, the adapter does not
# error in a way anyone notices — it hangs until the timeout, or returns nothing, and that
# is indistinguishable from a model with nothing to say. See docs/field-notes.md.
#
# A static list of flags in a document goes stale silently. This checks the LIVE CLI, so
# drift is caught the moment it happens rather than the next time someone needs an answer.

set -uo pipefail

_src="$0"
while [ -L "$_src" ]; do
  _d=$(cd -P "$(dirname "$_src")" && pwd); _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_d/$_src" ;; esac
done
ROOT=$(cd -P "$(dirname "$_src")/.." && pwd)
SNAP="$ROOT/reference/flags"

pass=0; fail=0; warn=0
P() { printf '  \033[32mOK\033[0m    %s\n' "$1"; pass=$((pass+1)); }
F() { printf '  \033[31mGONE\033[0m  %s\n' "$1"; fail=$((fail+1)); }
W() { printf '  \033[33m??\033[0m    %s\n' "$1"; warn=$((warn+1)); }

# How to get each provider's full flag surface. Add a line when you add an adapter.
help_for() {
  case "$1" in
    codex)   codex --help 2>&1; codex exec --help 2>&1 ;;
    copilot) copilot --help 2>&1 ;;
    claude)  claude --help 2>&1 ;;
    agy|antigravity) agy --help 2>&1 ;;
    *)       return 1 ;;
  esac
}

# The binary each provider is actually invoked as. NOT always the provider name — see
# docs/field-notes.md on why `command -v <vendor>` proves nothing.
cmd_for() {
  case "$1" in
    codex) echo codex ;; copilot) echo copilot ;; claude) echo claude ;;
    agy|antigravity) echo agy ;;   ollama)  echo curl ;;
    *)     echo "$1" ;;
  esac
}

# Flags an adapter actually depends on, harvested from its own documented invocations.
#
# Scoped to lines that invoke the provider binary, and git lines are excluded outright.
# Without that scoping this harvests `--detach`, `--force`, `--stat` and `--no-pager` from
# the worktree plumbing and reports them as missing provider flags — a false alarm that
# would train you to ignore the check, which is worse than not having it.
#
# Long flags only: single-dash forms are too ambiguous to match reliably in prose.
flags_used() {
  _c=$(cmd_for "$1")
  # Join backslash continuations FIRST. Real invocations span several lines, and scoping
  # before joining silently drops every flag that is not on the same line as the binary.
  cat "$ROOT/agents/$1-agent.md" "$ROOT/probes/$1.sh" 2>/dev/null \
    | sed -e :a -e '/\\$/N; s/\\\n[[:space:]]*/ /; ta' \
    | grep -E "(^|[|;(\` ])$_c " \
    | grep -vE "^[[:space:]]*(git|#|>)" \
    | grep -vE "[Dd]o not (use|reach|fall)|[Nn]ever (use|reach|widen)" \
    | grep -oE -- '--[a-z][a-z0-9-]+' \
    | grep -vxE -- '--help|--version' \
    | sort -u
}

# Why --help and --version are excluded — removing an exclusion is exactly the kind of
# tidying that looks harmless:
#
# `--help` can never appear in its own output. No CLI lists --help inside --help, so
# checking it reports GONE on a perfectly healthy provider, permanently. This shipped: one
# prose mention of "per `agy --help`" in an adapter was extracted as a flag, and
# quorum-flags then exited 1 on a fully working machine.
#
# That matters more than one wrong line. A check that fails when nothing is wrong teaches
# people to ignore it, which costs more than never having written it — the same reason this
# repo refuses `|| true` in CI. `--version` goes for the same reason: universal, and often
# absent from help output.
#
# The root cause is that the extractor scans for `<cli> ` anywhere in the adapter, so PROSE
# mentioning a flag is indistinguishable from an invocation using one. That is a deliberate
# trade — over-eagerness catches flags in examples and comments, which is where drift
# actually hides — but it means universal flags have to be excluded by name.

# Does this provider have a CLI with a --help surface AT ALL? This is a property of the
# provider, not of this machine, so it must not be decided by running anything.
#
# It used to be: "help_for succeeded". That conflates two completely different things --
# "this provider is a curl endpoint with no CLI" and "this provider has a CLI and you have
# not installed it". Measured on a box with no vendor CLIs:
#
#   not checked (curl-based, no --help surface to drift): antigravity codex copilot glm ollama
#   0 present, 0 missing, 0 unknown — across 0 of 5 adapters
#   EXIT=0
#
# Codex, Copilot and Antigravity are exactly the three that CAN drift, and they were
# reported as having nothing to drift. `quorum-flags && echo current` printed "current" on
# a machine that checked nothing.
has_cli() {
  case "$1" in
    codex|copilot|claude|agy|antigravity) return 0 ;;
    *) return 1 ;;
  esac
}

providers() {          # has a CLI, and it is installed here
  for f in "$ROOT"/probes/*.sh; do
    [ -e "$f" ] || continue
    p=$(basename "$f" .sh)
    has_cli "$p" && help_for "$p" >/dev/null 2>&1 && echo "$p"
  done
}

not_installed() {      # has a CLI, absent on this machine -- UNVERIFIED, not "nothing to check"
  for f in "$ROOT"/probes/*.sh; do
    [ -e "$f" ] || continue
    p=$(basename "$f" .sh)
    has_cli "$p" && ! help_for "$p" >/dev/null 2>&1 && echo "$p"
  done
}

# Adapters with no CLI to interrogate — curl-based providers have no --help surface, so
# there are no flag names to drift. Say so explicitly: "13 present, 0 missing" over three
# of five adapters reads as full coverage when it is not.
uncovered() {          # genuinely has no CLI surface: a curl endpoint
  for f in "$ROOT"/probes/*.sh; do
    [ -e "$f" ] || continue
    p=$(basename "$f" .sh)
    has_cli "$p" || echo "$p"
  done
}

case "${1:-check}" in
  --capture)
    mkdir -p "$SNAP"
    for p in $(providers); do
      help_for "$p" > "$SNAP/$p.txt" 2>&1
      printf '  captured %-10s %s lines\n' "$p" "$(wc -l < "$SNAP/$p.txt" | tr -d ' ')"
    done
    echo "Snapshot written to reference/flags/. Commit it — the diff is the point." ;;

  --diff)
    for p in $(providers); do
      [ -f "$SNAP/$p.txt" ] || { echo "  $p: no snapshot (run --capture)"; continue; }
      cur=$(mktemp); help_for "$p" > "$cur" 2>&1
      a=$(grep -oE -- '--[a-z][a-z0-9-]+' "$SNAP/$p.txt" | sort -u)
      b=$(grep -oE -- '--[a-z][a-z0-9-]+' "$cur" | sort -u)
      added=$(comm -13 <(printf '%s\n' "$a") <(printf '%s\n' "$b") | tr '\n' ' ')
      removed=$(comm -23 <(printf '%s\n' "$a") <(printf '%s\n' "$b") | tr '\n' ' ')
      printf '\n\033[1m%s\033[0m\n' "$p"
      [ -n "${removed// }" ] && printf '  \033[31mremoved:\033[0m %s\n' "$removed"
      [ -n "${added// }" ]   && printf '  \033[32madded:\033[0m   %s\n' "$added"
      [ -z "${removed// }" ] && [ -z "${added// }" ] && echo "  unchanged"
      rm -f "$cur"
    done ;;

  --list)
    p="${2:?usage: quorum-flags --list <provider>}"
    help_for "$p" 2>/dev/null | grep -oE -- '--[a-z][a-z0-9-]+' | sort -u \
      || { echo "quorum-flags: no help command known for '$p'" >&2; exit 1; } ;;

  check|"")
    echo "Checking that every flag our adapters use still exists in the live CLI."
    echo
    for p in $(providers); do
      h=$(mktemp); help_for "$p" > "$h" 2>&1
      printf '\033[1m%s\033[0m\n' "$p"
      used=$(flags_used "$p")
      [ -z "$used" ] && { W "no long flags found in the adapter (curl-based?)"; rm -f "$h"; continue; }
      for f in $used; do
        if grep -qF -- "$f" "$h"; then P "$f"; else F "$f  — not in --help any more"; fi
      done
      rm -f "$h"; echo
    done
    unc=$(uncovered | tr '\n' ' ')
    if [ -n "${unc// }" ]; then
      printf 'not checked (curl-based, no --help surface to drift): %s\n' "$unc"
    fi
    ni=$(not_installed | tr '\n' ' ')
    if [ -n "${ni// }" ]; then
      printf 'NOT CHECKED (CLI not installed here — these can drift and were not verified): %s\n' "$ni"
    fi
    printf '%d present, %d missing, %d unknown — across %s of %s adapters\n' \
      "$pass" "$fail" "$warn" "$(providers | wc -l | tr -d ' ')" "$(ls "$ROOT"/probes/*.sh | wc -l | tr -d ' ')"
    # "I checked nothing" must never exit 0. quorum-verify:215 already refuses this; there
    # was no reason for quorum-flags to be the exception, and being the exception is how
    # `quorum-flags && echo current` printed "current" having verified nothing at all.
    if [ $((pass + fail + warn)) -eq 0 ]; then
      echo
      echo "quorum-flags: no flags were checked — no provider CLI is installed on this machine." >&2
      echo "              This is not a pass. Install a provider CLI, or run this where one exists." >&2
      exit 1
    fi
    [ "$fail" -eq 0 ] || {
      echo
      echo "A missing flag does not fail loudly at runtime — it hangs, or returns nothing."
      echo "Fix the adapter before trusting any answer from that provider."
    }
    [ "$fail" -eq 0 ] ;;

  -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "quorum-flags: unknown argument '$1'" >&2; exit 1 ;;
esac
