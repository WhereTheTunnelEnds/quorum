#!/usr/bin/env bash
# quorum-status — which providers are usable right now.
#
# An executable rather than a shell function, on purpose: agents and scripts run in
# non-interactive shells, where functions and aliases do not exist. See docs/field-notes.md.
#
# Prints no credentials, no email addresses, and no key material.

set -uo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
quorum-status — which providers are reachable right now.

  quorum-status         live-check every provider and print a table

This makes REAL calls; it does not test for binaries. Not every provider ships a
command named after itself, so `command -v` proves nothing. See docs/field-notes.md.

Related:  quorum-auth (fix what is unauthenticated) · quorum-verify (does it work?)
USAGE
    exit 0 ;;
esac


avail=0
ok()   { printf '  \033[32m%s\033[0m  %s\n' "OK" "$1"; avail=$((avail+1)); }
bad()  { printf '  \033[31m%s\033[0m  %s\n' "--" "$1"; }
warn() { printf '  \033[33m%s\033[0m  %s\n' "??" "$1"; }

echo "quorum providers"
echo

# --- Claude Code ----------------------------------------------------------------
if [ -f "$HOME/.claude.json" ] && command -v jq >/dev/null 2>&1; then
  if jq -e 'has("oauthAccount")' "$HOME/.claude.json" >/dev/null 2>&1; then
    ok "claude    logged in"
  else
    bad "claude    not logged in  ->  run: claude"
  fi
else
  warn "claude    cannot determine (no ~/.claude.json or jq)"
fi

# --- Codex ----------------------------------------------------------------------
if command -v codex >/dev/null 2>&1; then
  if codex login status >/dev/null 2>&1; then
    ok "codex     logged in"
  else
    bad "codex     not logged in  ->  run: codex login"
  fi
else
  bad "codex     not installed"
fi

# --- Copilot --------------------------------------------------------------------
if command -v copilot >/dev/null 2>&1; then
  ok "copilot   $(copilot --version 2>&1 | head -1)"
else
  bad "copilot   not installed"
fi

# --- GLM / Z.AI -----------------------------------------------------------------
# Note: there is no `glm` binary. Never test for one — see docs/field-notes.md.
if [ -z "${Z_AI_API_KEY:-}" ]; then
  bad "glm       Z_AI_API_KEY not set  ->  export it from ~/.zshenv"
else
  body=$(curl -s -m 20 https://api.z.ai/api/anthropic/v1/messages \
    -H "Authorization: Bearer $Z_AI_API_KEY" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d '{"model":"glm-5.3","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}' 2>/dev/null)
  # Failures arrive inside HTTP 200, so classify on the body, not the exit code.
  if printf '%s' "$body" | grep -q '"content"'; then
    ok "glm       key accepted"
  else
    msg=$(printf '%s' "$body" | jq -r '.error.message // "no response"' 2>/dev/null || echo "no response")
    bad "glm       $msg"
  fi
fi

# --- Ollama (local model server) --------------------------------------------------
# Check the SERVER, not the binary: `ollama` can be installed with nothing serving, and a
# remote OLLAMA_BASE has no local binary at all. A real call is the only evidence.
OLLAMA_BASE="${OLLAMA_BASE:-http://localhost:11434}"
tags=$(curl -s -m 5 "$OLLAMA_BASE/api/tags" 2>/dev/null)
if [ -z "$tags" ]; then
  bad "ollama    no server at $OLLAMA_BASE  ->  run: ollama serve"
else
  count=$(printf '%s' "$tags" | jq -r '.models | length' 2>/dev/null || echo 0)
  case "$count" in ''|*[!0-9]*) count=0 ;; esac
  if [ "$count" -eq 0 ]; then
    bad "ollama    server up, no model pulled  ->  run: ollama pull llama3.2:3b"
  else
    names=$(printf '%s' "$tags" | jq -r '[.models[].name] | join(", ")' 2>/dev/null)
    ok "ollama    $count model(s): $names"
  fi
fi

# --- Antigravity -----------------------------------------------------------------
# The binary is `agy`, NOT `antigravity`. Presence only: probing auth costs a model call,
# which does not belong in a status command. Use quorum-auth for that.
if command -v agy >/dev/null 2>&1; then
  ok "agy       installed ($(agy --version 2>/dev/null | head -1))  ->  quorum-auth agy"
elif [ -x "$HOME/.local/bin/agy" ]; then
  bad "agy       installed but NOT on PATH here  ->  add ~/.local/bin in ~/.zshenv"
else
  bad "agy       not installed"
fi

# --- Locally configured endpoints ------------------------------------------------
ENDPOINT_DIR="${QUORUM_ENDPOINT_DIR:-$HOME/.config/quorum/endpoints}"
if [ -d "$ENDPOINT_DIR" ]; then
  echo
  echo "quorum-claude-on presets ($ENDPOINT_DIR)"
  found=0
  for f in "$ENDPOINT_DIR"/*.env; do
    [ -e "$f" ] || continue
    found=1
    name=$(basename "$f" .env)
    printf '      %s\n' "$name"
  done
  [ "$found" -eq 0 ] && printf '      (none)\n'
fi

# Exit code, because the script previously ended on `[ "$found" -eq 0 ]` and returned
# whatever that happened to be — reporting every provider OK while exiting 1, which breaks
# `quorum-status && …` and any CI use.
#
# Semantics: 0 if at least one provider is reachable, 1 if none are. Providers are optional,
# so a missing one is a normal state and must not fail the command; having NONE means Quorum
# cannot do anything, which is the only condition worth failing on.
if [ "$avail" -eq 0 ]; then
  echo
  echo "No providers are reachable. Run: quorum-auth" >&2
  exit 1
fi
exit 0
