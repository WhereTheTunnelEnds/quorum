#!/usr/bin/env bash
# quorum-status — which providers are usable right now.
#
# An executable rather than a shell function, on purpose: agents and scripts run in
# non-interactive shells, where functions and aliases do not exist. See docs/field-notes.md.
#
# Prints no credentials, no email addresses, and no key material.

set -uo pipefail

# Resolve through symlinks: install.sh links this onto PATH, so `dirname "$0"` would give
# ~/.local/bin rather than the repo. macOS has no `readlink -f`.
_qsrc="$0"
while [ -L "$_qsrc" ]; do
  _qdir=$(cd -P "$(dirname "$_qsrc")" && pwd)
  _qsrc=$(readlink "$_qsrc")
  case "$_qsrc" in /*) ;; *) _qsrc="$_qdir/$_qsrc" ;; esac
done
# shellcheck source=/dev/null
. "$(cd -P "$(dirname "$_qsrc")" && pwd)/quorum-lib.sh"

json=0
case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
quorum-status — which providers are reachable right now.

  quorum-status         live-check every provider and print a table
  quorum-status --json  the same checks, as JSON on stdout

It makes a REAL call wherever a real call is the only evidence: GLM gets an API request,
Ollama gets an /api/tags fetch, OpenRouter a /api/v1/key fetch (free — no model
call), Claude gets a credential check.

For copilot and agy it checks that the command EXISTS. That is a presence check, not
# an auth check. codex is different — it gets a real `codex login status` call, so a stub
# answering only --version reports "not logged in" rather than OK. Measured.
an auth check — a stub answering only --version reports OK here while `quorum-auth` correctly
says "not logged in". Use quorum-auth for authentication and quorum-verify for "does it
actually work".

What it never does is infer ABSENCE from a missing binary: GLM ships no `glm` command at all.
See docs/field-notes.md.

Exit status: 0 if at least one provider is reachable, 1 if none are. A provider you
do not use is a normal state, not a failure.

Related:  quorum-auth (fix what is unauthenticated) · quorum-verify (does it work?)
USAGE
    exit 0 ;;
  --json) json=1 ;;
  '') ;;
  # An unrecognised flag must not be silently ignored: a typo'd `--jsonn` would
  # otherwise print the human table and exit 0, and a machine consumer parsing that
  # as JSON gets a confusing failure far from its cause.
  *) printf 'quorum-status: unknown option %s (try --help)\n' "$1" >&2; exit 2 ;;
esac


# Checks record their result; rendering happens once at the end. Collecting first is what
# lets --json and the human table share one code path — the alternative, a render branch
# under every provider, doubles the file and lets the two outputs drift apart.
avail=0
rows=()

# The single choke point for anything this script did not write itself. That claim used to
# be made in a comment while two sinks bypassed it — the endpoint directory path and the
# preset filenames, both printed raw and both printed AFTER the table, so a cursor-up
# sequence in either could repaint every row above it. Route all of them through here.
scrub() {
  # LC_ALL=C is load-bearing, not decoration. Under a UTF-8 locale — the normal case,
  # LANG=en_US.UTF-8 — BSD tr aborts on the first byte that is not valid UTF-8 with
  # "Illegal byte sequence" and emits only what it read up to that point. Measured on input
  # 41 9b 42: LC_ALL=C returns 41 9b 42; the UTF-8 locale returns 41. A single invalid byte
  # would silently swallow the rest of the string, and swallow it differently on the
  # author's machine than in CI. Under LC_ALL=C, tr works bytewise, and multi-byte UTF-8
  # still survives because every one of its bytes is >= 0x80 — verified, café-日本
  # round-trips unchanged.
  #
  # SECOND PASS, for C1. The byte range above covers C0 and DEL and nothing else, so a
  # UTF-8-encoded C1 control walked straight through it -- measured, `41 c2 9b 48 42` came
  # out unchanged. U+009B is the single-character CSI: every byte after it is printable
  # ASCII, so `CSI H` + `CSI K` repaints the rows above without using one byte the first
  # pass removes. Exactly the hole that was found in the adapters; this file had it too.
  #
  # The two-byte C1 forms are precisely c2 80 .. c2 9f, and `c2` is only ever a UTF-8 LEAD
  # byte (continuation bytes are 80..bf, and no other multi-byte sequence begins with c2),
  # so a bytewise match cannot corrupt anything else. Verified: é (c3 a9), 日本, an emoji
  # and NBSP (c2 a0 -- adjacent to the range, deliberately kept) all round-trip unchanged.
  #
  # sed, not perl or jq: text mode must keep working on a box with neither. jq is optional
  # here and only --json requires it.
  #
  # A BARE 0x9b is left alone. It is invalid UTF-8, so removing it bytewise would risk
  # mangling adjacent characters, and it was measured INERT in both tmux 3.6a and GNU
  # screen 4.00.03 -- only the encoded form actually repainted the display.
  printf '%s' "$1" \
    | LC_ALL=C tr '\000-\037\177' ' ' \
    | LC_ALL=C sed "s/$(printf '\302')[$(printf '\200')-$(printf '\237')]//g"
}

record() {
  # Details are single-line display strings, and both renderers assume that. z.ai returns
  # .error.message straight from the API and Ollama returns model names chosen by whoever
  # published the model, so this is remote-controlled text: sanitise here, once, rather
  # than trusting six call sites.
  #
  # Sanitising lives in scrub(); see the rationale there.
  #
  # Length is NOT capped here, deliberately. Capping belongs in render_text, because a
  # byte-wise cut can split a multi-byte character in half, and feeding invalid UTF-8 to jq
  # is exactly the broken-document failure this function exists to prevent. Truncating for
  # display can at worst produce one mangled glyph on a terminal; truncating before jq can
  # produce no output at all.
  rows+=("$1"$'\t'"$2"$'\t'"$(scrub "$3")")
}
ok()   { record ok   "$1" "$2"; avail=$((avail+1)); }
bad()  { record bad  "$1" "$2"; }
warn() { record warn "$1" "$2"; }

# --- Claude Code ----------------------------------------------------------------
if [ -f "$HOME/.claude.json" ] && command -v jq >/dev/null 2>&1; then
  if jq -e 'has("oauthAccount")' "$HOME/.claude.json" >/dev/null 2>&1; then
    ok claude "logged in"
  else
    bad claude "not logged in  ->  run: claude"
  fi
else
  warn claude "cannot determine (no ~/.claude.json or jq)"
fi

# --- Codex ----------------------------------------------------------------------
if command -v codex >/dev/null 2>&1; then
  if codex login status >/dev/null 2>&1; then
    ok codex "logged in"
  else
    bad codex "not logged in  ->  run: codex login"
  fi
else
  bad codex "not installed"
fi

# --- Copilot --------------------------------------------------------------------
if command -v copilot >/dev/null 2>&1; then
  ok copilot "$(copilot --version 2>&1 | head -1)"
else
  bad copilot "not installed"
fi

# --- GLM / Z.AI -----------------------------------------------------------------
# Note: there is no `glm` binary. Never test for one — see docs/field-notes.md.
if [ -z "${Z_AI_API_KEY:-}" ]; then
  bad glm "Z_AI_API_KEY not set  ->  export it from $QUORUM_ENVFILE_SHORT"
else
  # The key must reach neither the command line nor the disk. Measured: with
# `-H "Authorization: Bearer $KEY"`, `ps auxww` shows the key to any process running as you.
  #
  # This was a chmod 600 mktemp file plus `trap 'rm -f "$_hdr"' EXIT INT TERM HUP`. The trap
  # was correct and still insufficient as a repo-wide answer: it has to be remembered at
  # every call site, and four of seven sites did not remember it. Before the trap existed
  # here, each run left a plaintext key file in the shared temp dir forever -- two
  # independent audits counted 110 and 241 of them on the author's machine, one per
  # invocation, 130 of 130 runs -- outliving key rotation, landing in backups, and on Linux
  # sitting in /tmp until systemd-tmpfiles ages it out ~10 days later.
  #
  # `--config <(...)` removes the file, so there is nothing to strand and no rule to
  # remember. curl reads the header from a /dev/fd pipe. tests/test-key-never-on-disk.sh
  # enforces this everywhere and is the gate that the old convention never had.
  body=$(curl -sS -m 20 https://api.z.ai/api/anthropic/v1/messages \
    -H @<(printf 'Authorization: Bearer %s\n' "$Z_AI_API_KEY") \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d '{"model":"glm-5.3","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}' 2>/dev/null)
  # Classify on the BODY, not the exit code. (The comment here used to say failures arrive
  # inside HTTP 200; docs/field-notes.md measures 400/401. The classifier was always right,
  # the explanation was not -- and it is the same wrong sentence this repo removed from five
  # other files.)
  if printf '%s' "$body" | grep -q '"content"'; then
    ok glm "key accepted"
  elif [ -z "$body" ]; then
    # Handle an EMPTY body BEFORE jq sees it. `jq -r '.x // "default"'` on zero bytes emits
    # ZERO BYTES and exits 0: the `//` never fires because there is no input to apply it to,
    # and the `|| echo` never fires because jq succeeded. Measured — 0 bytes, rc=0.
    #
    # So no network, DNS failure, TLS failure, a dead proxy or a timeout all produced a bare
    # "--  glm" with an EMPTY reason, followed by advice to get a fresh key: an outage
    # diagnosed as a bad credential. --json propagated it as detail:"".
    bad glm "no response from api.z.ai — network, DNS, proxy or timeout, NOT your key"
  else
    msg=$(printf '%s' "$body" | jq -r '.error.message // empty' 2>/dev/null || true)
    [ -n "$msg" ] || msg="unrecognised response from api.z.ai (not valid JSON, or an unknown shape)"
    bad glm "$msg"
  fi
fi

# --- Ollama (local model server) --------------------------------------------------
# Check the SERVER, not the binary: `ollama` can be installed with nothing serving, and a
# remote OLLAMA_BASE has no local binary at all. A real call is the only evidence.
OLLAMA_BASE="${OLLAMA_BASE:-http://localhost:11434}"
tags=$(curl -s -m 5 "$OLLAMA_BASE/api/tags" 2>/dev/null)
if [ -z "$tags" ]; then
  bad ollama "no server at $OLLAMA_BASE  ->  run: ollama serve"
else
  # Require .models to be an ARRAY, and count only entries that actually carry a .name.
  #
  # `jq '.models | length'` alone is not a model count, because length is polymorphic:
  # measured, a string gives its character count ("not-a-list" -> 10), an object gives its
  # key count ({"a":1,"b":2} -> 2), and a NUMBER gives its absolute value (12345 -> 12345).
  # So four response shapes containing no models at all reported green, available:true and
  # exit 0 — including "12345 model(s)". The `case` guard below passed them because they
  # are all digits.
  #
  # The realistic trigger is not a hostile server, it is a schema rename: a body of
  # [{"model":"x"},{"model":"y"}] is a well-formed array of two objects, so length is 2,
  # while `[.models[].name]` yields two nulls and the detail reads "2 model(s): , ".
  # Counting .name directly makes the count and the names agree by construction.
  count=$(printf '%s' "$tags" \
    | jq -r 'if (.models|type) == "array" then ([.models[] | select(.name? // empty)] | length) else 0 end' \
      2>/dev/null || echo 0)
  case "$count" in ''|*[!0-9]*) count=0 ;; esac
  if [ "$count" -eq 0 ]; then
    bad ollama "server up, no model pulled  ->  run: ollama pull llama3.2:3b"
  else
    names=$(printf '%s' "$tags" \
      | jq -r '[.models[] | select(.name? // empty) | .name] | join(", ")' 2>/dev/null)
    ok ollama "$count model(s): $names"
  fi
fi

# --- OpenRouter (metered gateway) -------------------------------------------------
# There is no `openrouter` binary. Check the KEY against /api/v1/key, which validates the
# credential and returns the balance WITHOUT a model call — so unlike a chat completion this
# costs nothing, which is what makes it appropriate for a status command.
if [ -z "${OPENROUTER_API_KEY:-}" ]; then
  bad openrouter "OPENROUTER_API_KEY not set  ->  export it from $QUORUM_ENVFILE_SHORT"
else
  # Key on a /dev/fd pipe, never argv and never a file — see the glm block above.
  orbody=$(curl -sS -m 20 https://openrouter.ai/api/v1/key \
    -H @<(printf 'Authorization: Bearer %s\n' "$OPENROUTER_API_KEY") 2>/dev/null)
  if [ -z "$orbody" ]; then
    # Empty body BEFORE jq sees it, for the reason documented in the glm block: jq on zero
    # bytes emits zero bytes and exits 0, so `// "default"` never fires and an outage gets
    # reported as a bad credential.
    bad openrouter "no response from openrouter.ai — network, DNS, proxy or timeout, NOT your key"
  elif printf '%s' "$orbody" | jq -e '.data' >/dev/null 2>&1; then
    # `.limit` is null on a pay-as-you-go key, which is not an error and must not render as
    # the string "null" — say what it means instead.
    ordetail=$(printf '%s' "$orbody" | jq -r '.data
      | "spent $\(.usage // 0)"
        + (if .limit then " of $\(.limit) (remaining $\(.limit_remaining // 0))"
           else " — no key limit set; account balance is the ceiling" end)' 2>/dev/null)
    [ -n "$ordetail" ] || ordetail="key accepted"
    ok openrouter "$ordetail"
  else
    ormsg=$(printf '%s' "$orbody" | jq -r '.error.message // empty' 2>/dev/null || true)
    [ -n "$ormsg" ] || ormsg="unrecognised response from openrouter.ai (not valid JSON, or an unknown shape)"
    bad openrouter "$ormsg"
  fi
fi

# --- Antigravity -----------------------------------------------------------------
# The binary is `agy`, NOT `antigravity`. Presence only: probing auth costs a model call,
# which does not belong in a status command. Use quorum-auth for that.
if command -v agy >/dev/null 2>&1; then
  ok agy "installed ($(agy --version 2>/dev/null | head -1))  ->  quorum-auth agy"
elif [ -x "$HOME/.local/bin/agy" ]; then
  bad agy "installed but NOT on PATH here  ->  add ~/.local/bin in $QUORUM_ENVFILE_SHORT"
else
  bad agy "not installed"
fi

# --- Locally configured endpoints ------------------------------------------------
ENDPOINT_DIR="${QUORUM_ENDPOINT_DIR:-$HOME/.config/quorum/endpoints}"
eps=()
if [ -d "$ENDPOINT_DIR" ]; then
  for f in "$ENDPOINT_DIR"/*.env; do
    [ -e "$f" ] || continue
    eps+=("$(basename "$f" .env)")
  done
fi

# --- Render ----------------------------------------------------------------------
# `${arr[@]+"${arr[@]}"}` and not `"${arr[@]}"`: under `set -u`, bash 3.2 — which is what
# macOS still ships as /bin/bash — treats an empty array as unset and aborts. Rows is never
# empty in practice, but eps usually is.

render_text() {
  echo "quorum providers"
  echo
  # Bound the DISPLAY length. With no bound, a long provider-controlled detail wraps, and
  # the continuation of a wrapped line starts at column 0 where it can be shaped like a
  # status row — no control characters required, so the sanitiser above never sees it. A
  # long enough name also scrolls the real rows off the pane entirely.
  #
  # Honest about the residual: this does not eliminate the forgery, because wrapping depends
  # on the terminal width and an attacker can emit one variant per plausible width. It
  # bounds the damage to roughly one extra line. What actually limits the attack is that
  # render_text resets colour immediately after the status glyph, so a forged row cannot be
  # green — verified with `tmux capture-pane -e`, no SGR sequence on the forged line. Use
  # --json if you need a representation with no display ambiguity at all.
  local r st name detail n
  for r in ${rows[@]+"${rows[@]}"}; do
    IFS=$'\t' read -r st name detail <<<"$r"
    [ "${#detail}" -gt 120 ] && detail="${detail:0:117}..."
    case "$st" in
      ok)   printf '  \033[32mOK\033[0m  %-10s %s\n' "$name" "$detail" ;;
      bad)  printf '  \033[31m--\033[0m  %-10s %s\n' "$name" "$detail" ;;
      warn) printf '  \033[33m??\033[0m  %-10s %s\n' "$name" "$detail" ;;
    esac
  done
  if [ -d "$ENDPOINT_DIR" ]; then
    echo
    # Both of these are filesystem-controlled, and both print AFTER the table, so an
    # unsanitised cursor-up sequence here reaches every row above it. Demonstrated with a
    # preset file whose name contained ESC[9A: it repainted a provider row.
    printf 'quorum-claude-on presets (%s)\n' "$(scrub "$ENDPOINT_DIR")"
    if [ "${#eps[@]}" -eq 0 ]; then
      printf '      (none)\n'
    else
      for n in "${eps[@]}"; do printf '      %s\n' "$(scrub "$n")"; done
    fi
  fi
}

render_json() {
  # jq builds the document rather than a printf template, so escaping is correct by
  # construction. `detail` carries remote-controlled text (z.ai echoes .error.message
  # verbatim), and hand-rolled escaping is precisely how you get invalid JSON emitted at
  # the moment a provider fails — which is when a machine consumer most needs this to work.
  if ! command -v jq >/dev/null 2>&1; then
    echo "quorum-status: --json requires jq" >&2
    exit 2
  fi
  printf '%s\n' ${rows[@]+"${rows[@]}"} \
  | jq -R -s \
      --arg endpoint_dir "$(scrub "$ENDPOINT_DIR")" \
      --arg endpoints "$(for _e in ${eps[@]+"${eps[@]}"}; do scrub "$_e"; echo; done)" \
      --argjson available "$avail" '
      {
        providers: (
          split("\n") | map(select(length > 0)) | map(split("\t"))
          | map({ key: .[1],
                  value: { status: .[0], available: (.[0] == "ok"), detail: .[2] } })
          | from_entries
        ),
        endpoint_dir: $endpoint_dir,
        endpoints: ($endpoints | split("\n") | map(select(length > 0))),
        available: $available
      }'
}

if [ "$json" -eq 1 ]; then render_json; else render_text; fi

# Exit code, because the script previously ended on `[ "$found" -eq 0 ]` and returned
# whatever that happened to be — reporting every provider OK while exiting 1, which breaks
# `quorum-status && …` and any CI use.
#
# Semantics: 0 if at least one provider is reachable, 1 if none are. Providers are optional,
# so a missing one is a normal state and must not fail the command; having NONE means Quorum
# cannot do anything, which is the only condition worth failing on. --json obeys the same
# rule, and still emits a complete document when it exits 1 — a consumer should be able to
# read WHICH providers are down from the same run that told it none were up.
if [ "$avail" -eq 0 ]; then
  [ "$json" -eq 1 ] || { echo; echo "No providers are reachable. Run: quorum-auth" >&2; }
  exit 1
fi
exit 0
